<h1>Support Tickets Dashboard</h1>
<%= link_to 'Create New Ticket', new_support_ticket_path %>
<p>Here you can view all reported issues.</p>

<table border="1" cellpadding="10">
  <thead>
    <tr>
      <th>ID</th>
      <th>Customer Name</th>
      <th>Issue Description</th>
      <th>Status</th>
      <th>Actions</th> </tr>
    </tr>
  </thead>
  <tbody>
    <% @tickets.each do |ticket| %>
      <tr>
        <td><%= ticket.id %></td>
        <td><strong><%= ticket.customer_name %></strong></td>
        <td><%= ticket.issue_description %></td>
        <td style="color: <%= ticket.status == 'Open' ? 'red' : (ticket.status == 'Closed' ? 'gray' : 'green') %>;">
          <%= ticket.status %>
        </td>
        <td>
          <%= link_to 'Edit', edit_support_ticket_path(ticket) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>